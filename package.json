{
  "name": "slotflow-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "SlotFlow — Smart scheduling and business operations SaaS with automated cancellation recovery",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server",
    "dev:server": "npm run dev --workspace=server",
