{
  "name": "slotflow-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "SlotFlow — Smart scheduling and business operations SaaS with automated cancellation recovery",
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=backend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:server": "npm run dev --workspace=backend",
    "dev:client": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:client": "npm run build --workspace=frontend",
    "start": "npm run start --workspace=backend",
    "worker": "npm run worker --workspace=backend",
    "test": "npm run test --workspace=backend",
    "test:unit": "npm run test:unit --workspace=backend",
    "test:integration": "npm run test:integration --workspace=backend",
    "test:concurrency": "npm run test:concurrency --workspace=backend",
    "test:e2e": "playwright test",
    "test:smoke": "node backend/src/scripts/productionSmokeTest.js",
    "test:all": "npm test && npm run test:e2e && npm run test:smoke",
    "seed": "npm run seed --workspace=backend"
  },
  "keywords": [
    "saas",
    "scheduling",
    "cancellation-recovery",
    "mern",
    "javascript",
    "esm"
  ],
  "author": "Harsh Srivastava",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
