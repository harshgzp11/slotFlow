NODE_ENV=development

# Server Port
PORT=5000

CLIENT_ORIGIN=https://slotflow.vercel.app

MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/slotflow?retryWrites=true&w=majority

SESSION_SECRET=your_at_least_32_character_cryptographically_secure_random_production_secret

ENABLE_BACKGROUND_WORKER=true

WORKER_INTERVAL_MS=15000