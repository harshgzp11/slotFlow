# SlotFlow Environment Configuration

# Server
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Database (MongoDB Atlas URI or local MongoDB)
MONGODB_URI=mongodb://localhost:27017/slotflow

# Session Secret (Random cryptographically secure string)
SESSION_SECRET=slotflow_super_secret_session_key_change_in_production_32chars

# Redis (Optional in local dev; uses in-memory scheduler if omitted)
# REDIS_URL=redis://localhost:6379

# Email Delivery (Optional in dev; logs as SIMULATED if omitted)
# EMAIL_PROVIDER_API_KEY=re_123456789
# EMAIL_FROM=notifications@slotflow.app
