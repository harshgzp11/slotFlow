# ==============================================================================
# SlotFlow .gitignore - Comprehensive Monorepo Ignore Rules
# ==============================================================================

# Environment & Secrets (Never commit credentials)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env.*
!**/.env.example
ENV_SETUP_GUIDE.txt
*.pem
*.key

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js

# Production Builds & Bundler Caches
dist/
**/dist/
build/
**/build/
.vite/
**/vite.config.js.timestamp-*

# Logs
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing & Coverage
coverage/
**/coverage/
.nyc_output/
.vitest/

# IDE & Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
.vscode/
.idea/
*.sublime-*
*.swp
*.swo
*~

# Assignment Prompts, Guidelines & Internal Plans (Excluded from public repository)
END_TERM_PROJECT_GUIDELINES.md
slotflow.md
slotflow_implementation_plan.md